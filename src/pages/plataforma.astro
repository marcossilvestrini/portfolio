---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ProfileSelector from '../components/ProfileSelector.astro';
import SkillCategory from '../components/SkillCategory.astro';
import TimelineCard from '../components/TimelineCard.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const experiencias = await getCollection('experiencias');
const habilidades = await getCollection('habilidades');

const filteredExp = experiencias
  .filter((e) => (e.data?.perfis || []).includes('plataforma'))
  .sort((a, b) => (a.data?.ordem ?? 0) - (b.data?.ordem ?? 0));

const filteredSkills = habilidades.filter((h) => (h.data?.perfis || []).includes('plataforma'));
---

<Layout title="Marcos Silvestrini - Engenharia de Plataforma">
  <Header />
  <ProfileSelector />
  <main class="px-4 py-4">
    <h2 class="h3 mb-4">Especialidade: Engenharia de Plataforma</h2>
    <section class="mb-5">
      {filteredSkills.map((h) => <SkillCategory {...h.data} />)}
    </section>
    <section class="mb-5">
      {filteredExp.map((e) => <TimelineCard {...e.data} />)}
    </section>
  </main>
  <Footer />
</Layout>
