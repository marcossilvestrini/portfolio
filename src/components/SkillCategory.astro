---
interface Props {
  categoria: string;
  porcentagem?: number;
  itens: { subcategoria: string; detalhes: string[] }[];
}

const { categoria, porcentagem, itens } = Astro.props;
const color = '#7186a8';
---

<article class="skill-card" style={`--skill-color: ${color}`}>
  <div class="skill-card__heading">
    <h3>{categoria}</h3>
    {porcentagem !== undefined && <span>{porcentagem}%</span>}
  </div>
  {
    porcentagem !== undefined && (
      <div
        class="skill-meter"
        role="progressbar"
        aria-label={`Nível de ${categoria}`}
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow={porcentagem}
      >
        <span style={`width: ${porcentagem}%`} />
      </div>
    )
  }
  <details class="skill-disclosure">
    <summary>
      Ver competências <span>{itens.length} {itens.length === 1 ? 'área' : 'áreas'}</span>
    </summary>
    <div class="skill-card__details">
      {
        itens.map((item) => (
          <div class="skill-detail">
            <h4>{item.subcategoria}</h4>
            <ul class="detail-list">
              {item.detalhes.map((detalhe) => (
                <li>{detalhe}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </details>
</article>
