---
import { getEntry } from 'astro:content';

const perfil = await getEntry('perfil', 'marcos');
const { nome, cargo, sobre, sociais } = perfil.data;
---

<header class="main-header">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <h1>{nome}</h1>
        <hr />
        <p>{cargo}</p>
        <hr />
        <div class="social-icons">
          {
            sociais.twitter && (
              <a href={sociais.twitter} target="_blank" title="Twitter">
                <i class="fab fa-twitter"></i>
              </a>
            )
          }
          {
            sociais.facebook && (
              <a href={sociais.facebook} target="_blank" title="Facebook">
                <i class="fab fa-facebook"></i>
              </a>
            )
          }
          {
            sociais.instagram && (
              <a href={sociais.instagram} target="_blank" title="Instagram">
                <i class="fab fa-instagram"></i>
              </a>
            )
          }
          {
            sociais.github && (
              <a href={sociais.github} target="_blank" title="Github">
                <i class="fab fa-github"></i>
              </a>
            )
          }
          {
            sociais.linkedin && (
              <a href={sociais.linkedin} target="_blank" title="LinkedIn">
                <i class="fab fa-linkedin-in"></i>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</header>

<section class="about-me">
  <div class="container">
    <div class="row">
      <div class="col-lg-12">
        <h2>Sobre Mim</h2>
        <hr />
        {sobre.map((paragraph: string) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>
</section>

<style>
  .main-header {
    text-align: center;
    padding: 2rem 0;
  }
  .social-icons a {
    margin: 0 10px;
    font-size: 1.5rem;
  }
</style>
