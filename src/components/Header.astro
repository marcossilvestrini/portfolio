---
import { getCollection } from 'astro:content';

let nome = '';
let cargo = '';
let idade = '';
let email = '';
let telefone = '';
let endereco = '';
let sobre = [];
let sociais = {};

const perfilCollection = await getCollection('perfil');
const perfilEntry = perfilCollection.find(entry => entry.id === 'marcos');

if (perfilEntry?.data) {
  ({ nome = '', cargo = '', idade = '', email = '', telefone = '', endereco = '', sobre = [], sociais = {} } = perfilEntry.data);
} else {
  console.warn('Perfil entry "marcos" not found in collection "perfil"');
}
---

<header class="header-section">
  <div class="cover-bg">
    <div class="header-grid">
      <div class="avatar-container">
        <div class="avatar shadow">
          <img src="/images/avatar.jpg" alt={nome} width="150" height="150" />
        </div>
      </div>
      <div class="info-container">
        <h1>{nome}</h1>
        <p class="title-sub">{cargo}</p>
        <div class="social-nav d-print-none">
          {sociais.twitter && <a href={sociais.twitter} target="_blank" title="Twitter"><i class="fab fa-twitter"></i></a>}
          {sociais.facebook && <a href={sociais.facebook} target="_blank" title="Facebook"><i class="fab fa-facebook"></i></a>}
          {sociais.instagram && <a href={sociais.instagram} target="_blank" title="Instagram"><i class="fab fa-instagram"></i></a>}
          {sociais.github && <a href={sociais.github} target="_blank" title="Github"><i class="fab fa-github"></i></a>}
          {sociais.linkedin && <a href={sociais.linkedin} target="_blank" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>}
        </div>
        <div class="actions d-print-none">
          <a class="btn btn-light" href="/resume.pdf" target="_blank">
            <i class="fa-solid fa-file-pdf"></i> Download PDF
          </a>
          <a class="btn btn-success" href="#contact">
            <i class="fa-solid fa-envelope"></i> Contato
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="about-section">
    <div class="about-grid">
      <div class="about-bio">
        <h3>Sobre Mim</h3>
        {sobre.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <div class="about-details">
        <div class="detail-row"><span class="detail-label">Idade</span><span>{idade}</span></div>
        <div class="detail-row"><span class="detail-label">E-mail</span><span><a href={`mailto:${email}`}>{email}</a></span></div>
        <div class="detail-row"><span class="detail-label">Telefone</span><span><a href={`tel:${telefone}`}>{telefone}</a></span></div>
        <div class="detail-row"><span class="detail-label">Endereço</span><span>{endereco}</span></div>
      </div>
    </div>
  </div>
</header>

<style>
  .header-section { border-bottom: 1px solid var(--border-color); }
  .cover-bg { background: linear-gradient(135deg, var(--primary-color) 0%, #1a365d 100%); color: white; padding: 2.5rem; }
  .header-grid { display: grid; grid-template-columns: auto 1fr; gap: 2rem; align-items: center; }
  @media (max-width: 768px) {
    .header-grid { grid-template-columns: 1fr; text-align: center; gap: 1.5rem; }
    .avatar-container { display: flex; justify-content: center; }
    .social-nav, .actions { justify-content: center; }
  }
  .avatar { background-color: white; border-radius: 50%; padding: 4px; width: 158px; height: 158px; overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .avatar img { border-radius: 50%; object-fit: cover; }
  .info-container h1 { color: white; font-size: 2.4rem; margin-bottom: 0.25rem; }
  .title-sub { font-size: 1.2rem; font-weight: 300; opacity: 0.9; margin-bottom: 1rem; }
  .social-nav { display: flex; gap: 1rem; margin-bottom: 1.25rem; }
  .social-nav a { color: rgba(255, 255, 255, 0.8); font-size: 1.3rem; transition: transform 0.2s ease; }
  .social-nav a:hover { color: white; transform: translateY(-2px); }
  .actions { display: flex; gap: 0.75rem; }
  .about-section { padding: 2rem 2.5rem; background-color: var(--bg-light); }
  .about-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2rem; }
  @media (max-width: 768px) { .about-grid { grid-template-columns: 1fr; } }
  .about-bio h3 { margin-bottom: 0.75rem; font-size: 1.3rem; }
  .about-bio p { margin-bottom: 0.5rem; color: #4a5568; font-size: 0.95rem; text-align: justify; }
  .about-details { display: flex; flex-direction: column; gap: 0.6rem; background-color: white; padding: 1.25rem; border-radius: 8px; border: 1px solid var(--border-color); justify-content: center; }
  .detail-row { display: flex; justify-content: space-between; font-size: 0.9rem; padding-bottom: 0.4rem; border-bottom: 1px dashed var(--border-color); }
  .detail-row:last-child { border-bottom: none; padding-bottom: 0; }
  .detail-label { font-weight: 600; color: var(--primary-color); }
  
  @media print {
    .cover-bg { background: none !important; color: black !important; padding: 1rem 0 !important; border-bottom: 2px solid black; }
    .info-container h1 { color: black !important; font-size: 2rem !important; }
    .title-sub { color: #333 !important; font-size: 1.1rem !important; }
    .avatar { border: 1px solid #ccc !important; width: 110px !important; height: 110px !important; }
    .avatar img { width: 102px !important; height: 102px !important; }
    .about-section { padding: 1.5rem 0 !important; background: none !important; }
    .about-details { border: none !important; padding: 0 !important; }
  }
</style>
