{
  "name": "portfolio",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node ./node_modules/astro/astro.js dev",
    "start": "node ./node_modules/astro/astro.js dev",
    "build": "node ./node_modules/astro/astro.js build",
    "preview": "node ./node_modules/astro/astro.js preview",
    "astro": "node ./node_modules/astro/astro.js",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --ext .js,.ts,.astro",
    "format": "node ./node_modules/prettier/bin/prettier.js --write .",
